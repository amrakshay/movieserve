# Android / Gradle.
# Deliberately not scoped to a module name: this repository has two Gradle projects, and the
# per-module version of this file silently failed to cover the second one when it was added.
.gradle/
build/
local.properties
*.apk
*.aab
*.keystore
# The wrapper jar is checked in on purpose, so a clone can build without Gradle installed first.
!gradle/wrapper/gradle-wrapper.jar

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and OS
.DS_Store
.idea/
*.iml
.vscode/
