<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:gravity="center"
    android:paddingStart="80dp"
    android:paddingEnd="80dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:fontFamily="sans-serif-light" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:inputType="textUri"
        android:singleLine="true"
        android:imeOptions="actionDone"
        android:nextFocusDown="@+id/save"
        android:nextFocusForward="@+id/save"
        android:textColor="@color/text"
        android:textSize="17sp"
        android:importantForAutofill="no"
        android:hint="http://192.168.0.116:18080"
        android:autofillHints="" />

    <Button
        android:id="@+id/save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/save" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="32dp"
        android:background="#1FFFFFFF" />

    <Button
        android:id="@+id/choosePlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/default_player" />

    <TextView
        android:id="@+id/currentPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

    <Button
        android:id="@+id/toggleAlwaysAsk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/always_ask" />

    <TextView
        android:id="@+id/alwaysAskState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />
</LinearLayout>
